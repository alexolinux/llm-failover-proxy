# Copy this file to nvidia-failover.env and fill in your keys:
#   cp nvidia-failover.env.example nvidia-failover.env
#   chmod 600 nvidia-failover.env
#
NVIDIA_API_KEY=nvapi-your-key-here

# Required only if you add "openrouter/..." models to config.yaml.
# Get one at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# Any secret string you pick — opencode will send this as its API key to your local proxy.
# Generate one with: python3 -c "import secrets; print('sk-litellm-' + secrets.token_hex(16))"
LITELLM_MASTER_KEY=sk-litellm-your-secret-master-key-here
